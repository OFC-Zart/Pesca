# Código que os amigos digitam para entrar. Em produção, sem ele o site fica trancado.
CODIGO_ACESSO=

# Postgres do Neon. As tabelas são criadas sozinhas no deploy. Sem ela, o diário fica só no aparelho.
DATABASE_URL=

# Protege a gravação diária das previsões. A Vercel envia este valor sozinha no cron.
CRON_SECRET=

# Postgres do Neon. As tabelas são criadas sozinhas no deploy. Sem ela, ninguém consegue entrar em produção.
DATABASE_URL=

# Código da turma, pedido só para criar conta. Você inventa e passa para os amigos.
CODIGO_ACESSO=

# Protege a gravação diária das previsões. A Vercel envia este valor sozinha no cron.
CRON_SECRET=
